# Copy this file to .env (git ignores .env) and fill in ONE key. The key stays on the server.
# No key? Use `npm run demo` instead: sample answers, nothing to set up.

# --- Google Gemini (default; has a free tier) ---
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite      # the current stable "basic" model; the free tier covers it
# GEMINI_THINKING_LEVEL=                  # minimal | low | medium | high (empty = the model's own default)

# --- Anthropic Claude (alternative; paid) ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_EFFORT=medium
# AI_REFUSAL_FALLBACK=1        # retry a safety refusal on another model (Claude API only)

# --- Court staff page: citation lookup (free) ---
# The court staff page (#court) checks the case citations in a filing against CourtListener, a free public case-law database.
# Only citation numbers are sent, never the filing. Make a free account at https://www.courtlistener.com, then copy your API token
# from your profile page. Without it the page still lists the citations, but checks none.
COURTLISTENER_TOKEN=

# --- Limits and hosting ---
# RATE_LIMIT_PER_MIN=20        # per client address (Gemini's free tier has its own, lower limits per project)
# DAILY_REQUEST_CAP=2000       # all clients together
# TRUST_PROXY=1                # number of proxies in front of the server
# PORT=3000
